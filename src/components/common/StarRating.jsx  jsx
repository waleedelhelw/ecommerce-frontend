import { FiStar } from 'react-icons/fi';
import { FaStar, FaStarHalfAlt } from 'react-icons/fa';

const StarRating = ({ rating, size = 16, showNumber = true, interactive = false, onChange }) => {
  const stars = [];
  const fullStars = Math.floor(rating);
  const hasHalf = rating % 1 >= 0.5;

  for (let i = 1; i <= 5; i++) {
    if (interactive) {
      stars.push(
        <button
          key={i}
          onClick={() => onChange && onChange(i)}
          className="focus:outline-none"
        >
          {i <= rating ? (
            <FaStar size={size} className="text-yellow-400" />
          ) : (
            <FiStar size={size} className="text-gray-300" />
          )}
        </button>
      );
    } else {
      if (i <= fullStars) {
        stars.push(<FaStar key={i} size={size} className="text-yellow-400" />);
      } else if (i === fullStars + 1 && hasHalf) {
        stars.push(<FaStarHalfAlt key={i} size={size} className="text-yellow-400" />);
      } else {
        stars.push(<FiStar key={i} size={size} className="text-gray-300" />);
      }
    }
  }

  return (
    <div className="flex items-center gap-1">
      <div className="flex items-center gap-0.5">{stars}</div>
      {showNumber && <span className="text-sm text-gray-500 mr-1">({rating})</span>}
    </div>
  );
};

export default StarRating;